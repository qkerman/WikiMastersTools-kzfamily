{
  "manifest_version": 3,
  "name": "WikiMasters - Prix moyen collection",
  "version": "4.17.1",
  "description": "Outils WikiMasters configurables : collections thématiques, prix moyens, collection, échanges, paquets, cartes full-art et Wikipédia.",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.wiki-masters.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wikimasters-tools@kzfamily",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wiki-masters.com/*"
      ],
      "js": [
        "bootstrap.js"
      ],
      "css": [
        "styles.css",
        "theme-tracker.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bridge/core.js",
        "bridge/collection.js",
        "bridge/packs.js",
        "bridge/intercept.js",
        "bridge/marketplace.js",
        "bridge/prices.js",
        "bridge/themes.js",
        "page-bridge.js",
        "features/core.js",
        "features/settings.js",
        "features/image-resolver.js",
        "features/price-ui.js",
        "features/price-loader.js",
        "features/card-extras.js",
        "features/pull-stats.js",
        "features/compact-mode.js",
        "features/trades.js",
        "features/modal-ui.js",
        "features/packs.js",
        "features/ranking.js",
        "features/collection-bulk.js",
        "features/extra-tools.js",
        "features/theme-tracker.js",
        "features/app.js",
        "content.js"
      ],
      "matches": [
        "https://www.wiki-masters.com/*"
      ]
    }
  ]
}
